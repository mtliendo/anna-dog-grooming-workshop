# Session cookie encryption key — generate with:
#   openssl rand -hex 32
AUTH0_SECRET=replace-with-openssl-rand-hex-32

# Where this Next.js app is running (used for Auth0 redirects)
APP_BASE_URL=http://localhost:3000

# Your Auth0 tenant domain — no https:// prefix
# Example: dev-abc123.us.auth0.com
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Regular Web Application credentials from the Auth0 Dashboard
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
